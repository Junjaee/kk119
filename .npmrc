# ARM architecture optimization settings
# Force rebuild of native modules for ARM
rebuild=true
target_arch=arm64
target_platform=linux
disturl=https://nodejs.org/download/release
runtime=node

# Performance optimizations
prefer-offline=true
audit=false
fund=false
save-exact=true

# Network settings
registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Build optimization
node-options=--max-old-space-size=4096